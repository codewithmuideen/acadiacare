# Copy to .env for local dev. In Vercel: Project → Settings → Environment Variables.

# ---- Browser-safe (bundled into the site) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ---- SERVER ONLY (never prefix with VITE_) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
RESEND_API_KEY=re_xxx
# Must be on a domain verified in Resend
RESEND_FROM=Acadia Care <website@acadiacare.co.uk>
# Inbox that receives applications and enquiries (comma separate for several)
ADMIN_EMAIL=care@acadiacare.co.uk
SITE_URL=https://acadiacare.co.uk
# Optional: lock the API to your domain(s), comma separated
ALLOWED_ORIGIN=https://acadiacare.co.uk,https://www.acadiacare.co.uk
