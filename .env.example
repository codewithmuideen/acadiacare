# ---------------------------------------------------------------
# SERVER-SIDE ONLY. Never prefix these with VITE_ — anything with a
# VITE_ prefix is bundled into public JavaScript.
# Set these in your hosting provider's environment settings.
# ---------------------------------------------------------------

# Resend (https://resend.com) — used by /api/contact and /api/enquiry
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "Acadia Care <website@acadiacare.co.uk>"
RESEND_FROM=
# Inbox(es) that receive website enquiries (comma separated)
CONTACT_TO=care@acadiacare.co.uk
# Optional: separate inbox for recruitment enquiries
RECRUITMENT_TO=care@acadiacare.co.uk
# Allowed browser origin for the API (CORS / CSRF check)
ALLOWED_ORIGIN=https://acadiacare.co.uk

# ---------------------------------------------------------------
# Staff application form — see docs/SECURE-APPLICATION-SUBMISSION.md
# This is a URL (not a secret) for the secure application backend.
# Leave empty until a compliant backend exists: the form will then
# clearly tell applicants online submission is unavailable.
# ---------------------------------------------------------------
VITE_SECURE_APPLICATION_ENDPOINT=
